set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_VERSION 6.1)
set(CMAKE_SYSTEM_PROCESSOR AMD64)
set(CMAKE_USER_MAKE_RULES_OVERRIDE "${CMAKE_CURRENT_LIST_DIR}/zig-rules.cmake")
if(NOT DEFINED ENV{ZIG_EXECUTABLE})
  message(FATAL_ERROR "Set ZIG_EXECUTABLE to the absolute path of zig.exe")
endif()
set(CMAKE_C_COMPILER "$ENV{ZIG_EXECUTABLE}")
set(CMAKE_C_COMPILER_ARG1 "cc -target x86_64-windows.win7-gnu")
set(CMAKE_CXX_COMPILER "$ENV{ZIG_EXECUTABLE}")
set(CMAKE_CXX_COMPILER_ARG1 "c++ -target x86_64-windows.win7-gnu")
set(CMAKE_RC_COMPILER "$ENV{ZIG_EXECUTABLE}")
set(CMAKE_RC_COMPILER_ARG1 "rc")
set(CMAKE_AR "$ENV{ZIG_EXECUTABLE}" CACHE FILEPATH "" FORCE)
set(CMAKE_C_ARCHIVE_CREATE "<CMAKE_AR> ar qc <TARGET> <LINK_FLAGS> <OBJECTS>")
set(CMAKE_CXX_ARCHIVE_CREATE "<CMAKE_AR> ar qc <TARGET> <LINK_FLAGS> <OBJECTS>")
set(CMAKE_C_ARCHIVE_FINISH "")
set(CMAKE_CXX_ARCHIVE_FINISH "")
