{
  "noah-lulu": {
    "version": "1.5.0",
    "schedule": {
      "schedule.soon": {
        "action": "look_around",
        "text": "还有十分钟，陪你等到收工。"
      },
      "schedule.offwork": {
        "action": "jump",
        "text": "下班啦！今天辛苦了！"
      }
    },
    "ball": {
      "states": [
        "calm_company"
      ],
      "leftAction": "amble_left",
      "rightAction": "amble_right",
      "touchAction": "wave"
    },
    "focus": {
      "action": "jump",
      "text": "这一段完成啦，起来伸个懒腰吧。"
    },
    "gifts": [
      {
        "id": "gift_coffee",
        "action": "jump",
        "label": "送杯咖啡",
        "text": "搭子送来一杯咖啡，辛苦啦。",
        "display": {
          "symbol": "☕",
          "label": "暖暖咖啡",
          "durationMs": 15000
        }
      },
      {
        "id": "gift_flower",
        "action": "jump",
        "label": "送朵小花",
        "text": "收到搭子的小花，今天也要开心。",
        "display": {
          "symbol": "✿",
          "label": "给你小花",
          "durationMs": 15000
        }
      },
      {
        "id": "gift_star",
        "action": "jump",
        "label": "送颗星星",
        "text": "把这颗小星星送给你。",
        "display": {
          "symbol": "★",
          "label": "幸运星",
          "durationMs": 15000
        }
      }
    ],
    "exploration": {
      "observeAction": "look_around",
      "leftAction": "amble_left",
      "rightAction": "amble_right",
      "jumpAction": "jump",
      "restAction": "waiting",
      "jumpDurationMs": 900
    }
  },
